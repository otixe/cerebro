# Copy to .env and edit. Never commit .env.

# --- Postgres ---
POSTGRES_DB=cerebro
POSTGRES_USER=cerebro
POSTGRES_PASSWORD=change-me

# --- Bootstrap agent (first key; create the rest through the API) ---
# Comma-separated names; each NAME reads its key from <NAME>_API_KEY.
BOOTSTRAP_AGENTS=admin
ADMIN_API_KEY=change-me-too

# --- Embeddings ---
# Default (nothing to set): local Ollama EmbeddingGemma, 768 dims, no account.
QDRANT_COLLECTION=cerebro_memory
# Optional cloud embeddings through AWS Bedrock (needs AWS credentials: AWS_PROFILE / AWS_REGION).
# EMBEDDING_BACKEND accepts only "ollama" (default) or "bedrock"; any other value fails at startup.
# Cohere via Bedrock:
# EMBEDDING_BACKEND=bedrock
# BEDROCK_MODEL_ID=cohere.embed-multilingual-v3
# EMBEDDING_DIMS=1024
# QDRANT_COLLECTION=cerebro_memory_cohere   # dims changed: use a NEW collection

# --- Vault (markdown notes indexed into memory) ---
VAULT_DIR=./examples/vault

# --- Exposure (default: localhost only) ---
GATEWAY_PUBLISH=127.0.0.1:8765
MCP_PUBLISH=127.0.0.1:8766
MCP_SSE_PUBLISH=127.0.0.1:8767
LOG_LEVEL=INFO
